<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows launcher: QSO-LOG.exe starts app\qsolog.jar with the bundled runtime\ folder.
     The jar is not wrapped into the exe: unsigned wrapped exes trigger more antivirus false positives. -->
<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>app\qsolog.jar</jar>
  <outfile>../build/windows/QSO-LOG/QSO-LOG.exe</outfile>
  <errTitle>QSO-LOG</errTitle>
  <chdir>.</chdir>
  <priority>normal</priority>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <icon>../icons/icon.ico</icon>
  <jre>
    <path>runtime</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>true</requires64Bit>
    <opt>-Dfile.encoding=UTF-8</opt>
    <opt>-Dsun.stdout.encoding=UTF-8</opt>
    <opt>-Xmx768m</opt>
  </jre>
  <singleInstance>
    <mutexName>ru.r3xed.qsolog</mutexName>
    <windowTitle>QSO-LOG</windowTitle>
  </singleInstance>
  <versionInfo>
    <fileVersion>@VERSION@.0</fileVersion>
    <txtFileVersion>@VERSION@</txtFileVersion>
    <fileDescription>QSO-LOG</fileDescription>
    <copyright>R3XED</copyright>
    <productVersion>@VERSION@.0</productVersion>
    <txtProductVersion>@VERSION@</txtProductVersion>
    <productName>QSO-LOG</productName>
    <companyName>R3XED</companyName>
    <internalName>qsolog</internalName>
    <originalFilename>QSO-LOG.exe</originalFilename>
    <language>RUSSIAN</language>
  </versionInfo>
</launch4jConfig>
